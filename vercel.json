{
  "version": 2,
  "builds": [{ "src": "api/mcp.js", "use": "@vercel/node" }],
  "routes": [
    { "src": "/.well-known/oauth-protected-resource", "dest": "/api/mcp.js" },
    { "src": "/.well-known/oauth-protected-resource/mcp", "dest": "/api/mcp.js" },
    { "src": "/.well-known/oauth-authorization-server", "dest": "/api/mcp.js" },
    { "src": "/mcp", "dest": "/api/mcp.js" },
    { "src": "/", "dest": "/api/mcp.js" }
  ]
}
